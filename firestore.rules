rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Trusted contacts subcollection
      // A user can only manage their own trusted contacts
      // Trusted contact access must NOT be granted merely because someone knows an ID
      match /trustedContacts/{contactId} {
        allow read, write: if isOwner(userId);
      }

      // User devices / FCM tokens
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Journeys collection
    // Users can create, read, and update only their own journeys
    match /journeys/{journeyId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Locations subcollection along a journey
      // Only the journey owner can read or write locations
      match /locations/{locationId} {
        allow read, write: if isAuthenticated() &&
          get(/databases/$(database)/documents/journeys/$(journeyId)).data.userId == request.auth.uid;
      }
    }

    // Emergencies collection
    // Users can access only their own emergency records
    // Privileged multi-party delivery and verification is handled server-side (Cloud Functions)
    match /emergencies/{emergencyId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false; // Audit trail preservation
    }

    // Community hazards (Foundation)
    // Authenticated users can read hazards and report new hazards
    match /communityHazards/{hazardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.reportedBy == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
